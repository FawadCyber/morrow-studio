# First owner account (created on first start)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=choose-a-strong-password

# Shared secret between n8n and the dashboard (also set it in the workflow's "Authorized?" node)
INGEST_KEY=generate-a-long-random-string

# PostgreSQL (leave empty to use data/db.json for local development)
DATABASE_URL=postgres://morrow_studio:password@localhost:5432/morrow_studio

# Public address, used in share links
PUBLIC_URL=https://morrow.example.com
